# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:55432/plataforma_apps

# JWT
JWT_SECRET=troque_esta_chave_por_uma_string_aleatoria_e_segura
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# CORS
CORS_ORIGINS=http://localhost:3000

# App
DEBUG=True
APP_NAME=Plataforma de Apps
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# E-mail (SMTP) - se vazio, os e-mails só são logados no console do backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cobrança da plataforma (upgrade de plano) - credenciais próprias, distintas
# das credenciais por-app usadas nos módulos de pagamento dentro dos apps
PLATFORM_MERCADO_PAGO_TOKEN=
PLATFORM_PAYPAL_CLIENT_ID=
PLATFORM_PAYPAL_CLIENT_SECRET=
PLATFORM_PAGSEGURO_TOKEN=

# Push notifications (VAPID) - gere com: python -m app.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Login social (Facebook) para usuários finais dos apps publicados - um único
# App do Facebook atende todos os apps criados na plataforma
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
